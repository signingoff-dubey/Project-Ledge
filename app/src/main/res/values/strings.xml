    <string name="setup_welcome_title">A dock on the edge</string>
    <string name="setup_welcome_body">Swipe inward and a droplet slides out of the screen edge. Drag the handle, or the slider, to move it. The next step asks to draw over other apps so that position works outside Ledge too.</string>
    <string name="setup_preview">Preview of the side dock</string>
    <string name="setup_permission_title">Permissions</string>
    <string name="setup_permission_body">Drawing the dock outside Ledge needs permission to appear over other apps. The ongoing notice is optional. Ledge does not ask for accessibility, microphone, phone, contacts, or Bluetooth access.</string>
    <string name="setup_overlay">Draw over other apps</string>
    <string name="setup_overlay_reason">Places the dock on the screen edge in other apps, at the height set by the slider.</string>
    <string name="setup_accessibility">Accessibility</string>
    <string name="setup_accessibility_reason">Not used. Ledge does not read or control other apps.</string>
    <string name="setup_accessibility_privacy">An accessibility service is not installed. Nothing on other screens is observed.</string>
    <string name="setup_microphone">Microphone</string>
    <string name="setup_microphone_reason">Not used. Assist does not listen through the microphone.</string>
    <string name="setup_phone">Phone and contacts</string>
    <string name="setup_phone_reason">Not used. Calls in the sample stay inside the app.</string>
    <string name="setup_contacts">Contacts</string>
    <string name="setup_contacts_reason">Not used. The sample contact is built in.</string>
    <string name="setup_nearby">Nearby devices</string>
    <string name="setup_nearby_reason">Not used. The Bluetooth control does not change the phone radio.</string>
    <string name="setup_notifications">Notifications</string>
    <string name="setup_notifications_reason">Optional. A quiet ongoing notice while the dock is available outside Ledge.</string>
    <string name="setup_privacy">Sample actions stay on this device. Ledge does not upload what you do with the dock, and it does not read what is on screen behind the dock.</string>
